{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dezzi-summer-style",
  "compatibility_date": "2026-06-11",
  "observability": {
    "enabled": true
  },
  "main": "dist/server/server.js", 
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
